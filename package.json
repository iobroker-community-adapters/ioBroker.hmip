{
  "name": "iobroker.hmip",
  "version": "3.3.0",
  "description": "ioBroker Adapter to use the Homematic Cloud IP AccessPoint via Homematic Cloud Rest API",
  "author": "Apollon77 <iobroker@fischer-ka.de>",
  "contributors": [
    "jogibear9988 <jochen.kuehner@gmx.de>",
    "Apollon77 <iobroker@fischer-ka.de>",
    "iobroker-community-adapters <iobroker-community-adapters@gmx.de>"
  ],
  "homepage": "https://github.com/iobroker-community-adapters/ioBroker.hmip",
  "license": "MIT",
  "keywords": [
    "ioBroker",
    "homematic",
    "cloud"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/iobroker-community-adapters/ioBroker.hmip"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "axios": "^1.20.0",
    "js-sha512": "^0.9.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/legacy-testing": "^3.0.1",
    "@iobroker/testing": "^6.2.2",
    "@iobroker/types": "^7.2.3",
    "@tsconfig/node22": "^22.0.6",
    "@types/node": "^26.6.2",
    "@types/proxyquire": "^1.3.31",
    "@vitalets/google-translate-api": "^9.2.1",
    "colorette": "^2.0.20",
    "configstore": "^8.0.0",
    "puppeteer": "^25.12.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "build/",
    "docs/",
    "LICENSE",
    "io-package.json"
  ],
  "scripts": {
    "test:js": "mocha --config test/mocharc.custom.json \"{!(node_modules|test)/**/*.test.js,*.test.js,test/**/test!(PackageFiles|Startup|Adapter.gui).js}\"",
    "test:gui": "mocha test/testAdapter.gui --exit",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package && npm run test:gui",
    "lint": "eslint -c eslint.config.mjs .",
    "build-backend": "tsc -p tsconfig.build.json",
    "build-admin": "tsx tasks.ts",
    "build": "npm run build-backend && npm run build-admin",
    "watch": "tsc -p tsconfig.build.json --watch",
    "check": "tsc -p tsconfig.json --noEmit",
    "npm": "npm i && cd src-admin && npm i -f",
    "translate": "translate-adapter",
    "release": "release-script",
    "release-patch": "release-script patch --yes --no-update-lockfile",
    "release-minor": "release-script minor --yes --no-update-lockfile",
    "release-major": "release-script major --yes --no-update-lockfile",
    "update-packages": "npx -y npm-check-updates --upgrade && cd src-admin && npx -y npm-check-updates --upgrade",
    "task0clean": "tsx tasks.ts --0-clean",
    "task1npm": "tsx tasks.ts --1-npm",
    "task2compile": "tsx tasks.ts --2-compile",
    "task3copy": "tsx tasks.ts --3-copy",
    "taskBuild": "tsx tasks.ts"
  },
  "bugs": {
    "url": "https://github.com/iobroker-community-adapters/ioBroker.hmip/issues"
  },
  "readmeFilename": "README.md"
}
